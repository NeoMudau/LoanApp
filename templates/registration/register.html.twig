{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center bg-gradient-to-tr from-blue-900 via-indigo-900 to-green-800 p-4">
    <div class="w-full max-w-md bg-white/10 backdrop-blur-xl border border-white/20 rounded-2xl shadow-2xl overflow-hidden p-8 text-blue-100">
        {% for flash_error in app.flashes('verify_email_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
        {% endfor %}

        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-white tracking-light">Register</h1>
            <p class="text-blue-200 mt-2">Welcome! Please enter your details.</p>
        </div>

        {% if form_errors(registrationForm) %}
            <div class="mb-6 p-4 rounded-lg bg-red-500/20 border border-red-500/40 text-red-100 text-sm text-center">
                {{ form_errors(registrationForm) }}
            </div>
        {% endif %}

        {{ form_start(registrationForm) }}
            <div class="email-section mb-6">
                {{ form_label(registrationForm.email) }}
                <div class="input-container">
                    {{ form_widget(registrationForm.email, 
                        {'attr': 
                            {   'class': 'form-control  w-full py-3 bg-white text-blue-900 hover:bg-blue-50 font-bold rounded-xl shadow-lg transition-all active:scale-95 mt-2 p-4', 
                                'placeholder': 'email@example.com'}
                        }) }}
                </div>
                {{ form_errors(registrationForm.email) }}
            </div>
            <div class="passowrd-section mb-6">
                {{ form_label(registrationForm.plainPassword, 'Password',) }}
                <div class="input-container" >
                    {{ form_widget(registrationForm.plainPassword, 
                        {attr: 
                         {class: ' w-full py-3 bg-white text-blue-900 hover:bg-blue-50 font-bold rounded-xl shadow-lg transition-all active:scale-95 mt-2 p-4'}}) }}
                </div>
                {{ form_errors(registrationForm.plainPassword) }}
            </div>
            <div class="terms-section">
                <div class="term-checkbox">
                    {{ form_widget(registrationForm.agreeTerms, {attr: {style: 'margin-top: 5px;'}}) }}
                    {{ form_label(registrationForm.agreeTerms, 'Click to agree to the terms', {'label_attr': {'style': 'margin-left: 10px;'}}) }}
                </div>
                {{ form_errors(registrationForm.agreeTerms) }}
            </div>

            <button type="submit" 
            class="w-full py-3 bg-white text-blue-900 hover:bg-blue-50 font-bold rounded-xl shadow-lg transition-all active:scale-95 mt-4">
            Register</button>

        {{ form_rest(registrationForm) }}
        {{ form_end(registrationForm) }}

        <div class="mt-8 text-center border-t border-white/10 pt-6">
            <p class="text-blue-200">Already have an account? <a href="{{ path('app_login') }}" class="text-sm text-blue-200 hover:text-white transition">Click here to login.</a></p>
        </div>
    </div>
    
</div>
    
{% endblock %}
