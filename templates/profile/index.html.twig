
{% extends 'base.html.twig' %}

{% block title %}My Profile | QuickLoan{% endblock %}

{% block body %}

<div class="auth-page">

    <div class="auth-card" style="max-width: 850px;">

        <div class="auth-header">
            <h1>Complete Your Profile</h1>
            <p>Provide your address, employment and monthly expense details to continue with QuickLoan.</p>
        </div>

        {# Flash Messages #}
        {% for message in app.flashes('success') %}
            <div class="auth-error" style="border-color: rgba(16,185,129,0.3); background: rgba(16,185,129,0.12); color: #6ee7b7; margin-bottom: 1.25rem;">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('warning') %}
            <div class="auth-error" style="border-color: rgba(245,158,11,0.3); background: rgba(245,158,11,0.12); color: #fcd34d; margin-bottom: 1.25rem;">
                {{ message }}
            </div>
        {% endfor %}

        {# Address Section #}
        <section style="margin-bottom: 2.5rem;">

            <h2 style="color: var(--white); font-family: 'Syne', sans-serif; margin-bottom: 1.25rem;">
                Residential Address
            </h2>

            {{ form_start(addressForm, {'attr': {'class': 'auth-form-grid'}}) }}

                {% for field in addressForm %}
                    {% if field.vars.name != '_token' %}
                        <div class="auth-field">
                            {{ form_label(field) }}
                            {{ form_widget(field, {'attr': {'class': 'auth-input'}}) }}
                            <div class="auth-field-error">
                                {{ form_errors(field) }}
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}

                <div class="auth-full-width">
                    <button type="submit" class="auth-button">
                        Save Address
                    </button>
                </div>

            {{ form_end(addressForm) }}

        </section>

        <div style="border-top: 1px solid rgba(59,130,246,0.15); margin: 2rem 0;"></div>

        {# Employment Section #}
        <section style="margin-bottom: 2.5rem;">

            <h2 style="color: var(--white); font-family: 'Syne', sans-serif; margin-bottom: 1.25rem;">
                Employment Details
            </h2>

            {{ form_start(employmentForm, {'attr': {'class': 'auth-form-grid'}}) }}

                {% for field in employmentForm %}
                    {% if field.vars.name != '_token' %}
                        <div class="auth-field">
                            {{ form_label(field) }}
                            {{ form_widget(field, {'attr': {'class': 'auth-input'}}) }}
                            <div class="auth-field-error">
                                {{ form_errors(field) }}
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}

                <div class="auth-full-width">
                    <button type="submit" class="auth-button">
                        Save Employment Details
                    </button>
                </div>

            {{ form_end(employmentForm) }}

        </section>

        <div style="border-top: 1px solid rgba(59,130,246,0.15); margin: 2rem 0;"></div>

        {# Monthly Expenses Section #}
        <section>

            <h2 style="color: var(--white); font-family: 'Syne', sans-serif; margin-bottom: 0.5rem;">
                Monthly Expenses
            </h2>

            <p style="color: var(--muted); margin-bottom: 1.5rem;">
                Add your regular monthly expenses. This information helps QuickLoan assess your affordability.
            </p>

            {{ form_start(expenseForm, {'attr': {'class': 'auth-form-grid'}}) }}

                {% for field in expenseForm %}
                    {% if field.vars.name != '_token' %}
                        <div class="auth-field">
                            {{ form_label(field) }}
                            {{ form_widget(field, {'attr': {'class': 'auth-input'}}) }}
                            <div class="auth-field-error">
                                {{ form_errors(field) }}
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}

                <div class="auth-full-width">
                    <button type="submit" class="auth-button">
                        Add Monthly Expense
                    </button>
                </div>

            {{ form_end(expenseForm) }}

            {# Existing Expenses #}
            <div style="margin-top: 2rem;">

                <h3 style="color: var(--white); font-family: 'Syne', sans-serif; margin-bottom: 1rem;">
                    Your Recorded Expenses
                </h3>

                {% if monthlyExpenses is not empty %}

                    {% for expense in monthlyExpenses %}
                        <div style="padding: 1rem; margin-bottom: 0.75rem; border: 1px solid rgba(59,130,246,0.2); border-radius: 10px; background: rgba(10,21,53,0.5);">

                            <div style="display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">

                                <strong style="color: var(--white);">
                                    {{ expense.category }}
                                </strong>

                                <strong style="color: var(--glow);">
                                    R {{ expense.amount|number_format(2, '.', ',') }}
                                </strong>

                            </div>

                            {% if expense.description %}
                                <p style="color: var(--muted); margin-top: 0.5rem; margin-bottom: 0;">
                                    {{ expense.description }}
                                </p>
                            {% endif %}

                        </div>
                    {% endfor %}

                    <div style="border-top: 1px solid rgba(59,130,246,0.2); padding-top: 1rem; margin-top: 1rem; display: flex; justify-content: space-between;">
                        <strong style="color: var(--white);">Total Monthly Expenses</strong>
                        <strong style="color: var(--glow);">
                            R {{ monthlyExpenses|reduce((total, expense) => total + expense.amount, 0)|number_format(2, '.', ',') }}
                        </strong>
                    </div>

                {% else %}

                    <p style="color: var(--muted);">
                        You haven't added any monthly expenses yet.
                    </p>

                {% endif %}

            </div>

        </section>

    </div>

</div>

{% endblock %}
