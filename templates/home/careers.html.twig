                        <span class="sp-val">24</span>
                        <span class="sp-label">Team members</span>
                    </div>
                    <div class="stat-pill">
                        <div class="sp-icon" style="background:var(--green-soft);color:var(--green);">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>
                        </div>
                        <span class="sp-val">4.8</span>
                        <span class="sp-label">Culture rating</span>
                    </div>
                    <div class="stat-pill">
                        <div class="sp-icon" style="background:var(--amber-soft);color:var(--amber);">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                        </div>
                        <span class="sp-val">48h</span>
                        <span class="sp-label">Avg. hiring response</span>
                    </div>
                </div>
            </div>
            <div class="hiring-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
