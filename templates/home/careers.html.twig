                </div>
            </a>
        #}

        {# ── EMPTY STATE ── #}
        {% if jobs is not defined or jobs is empty %}
        <div class="empty-state">
            <div class="empty-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><line x1="12" y1="12" x2="12" y2="16"/><line x1="10" y1="14" x2="14" y2="14"/></svg>
            </div>
            <h3>No open positions right now</h3>
            <p>We're not actively hiring at the moment, but that can change fast. Drop your email below and we'll notify you the moment a role opens up.</p>
            <form class="notify-form" method="POST" action="{{ path('app_careers_notify') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('careers_notify') }}"/>
                <input type="email" name="email" placeholder="your@email.com" required />
                <button type="submit" class="notify-btn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                    Notify me
                </button>
            </form>
        </div>
        {% endif %}
    </div>

    {# ── PERKS ── #}
    <div class="perks-strip">
        <div class="perk">
            <div class="perk-icon" style="background:var(--accent-soft);color:var(--accent);">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h4>Medical aid</h4>
            <p>Full medical aid contribution for you and your dependants from day one.</p>
        </div>
        <div class="perk">
            <div class="perk-icon" style="background:var(--green-soft);color:var(--green);">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
            <h4>Remote flexibility</h4>
            <p>Hybrid and fully remote options available depending on your role.</p>
        </div>
        <div class="perk">
            <div class="perk-icon" style="background:var(--amber-soft);color:var(--amber);">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            </div>
            <h4>Learning budget</h4>
            <p>R10 000 annual budget for courses, certifications, and conferences.</p>
        </div>
        <div class="perk">
            <div class="perk-icon" style="background:rgba(139,92,246,.12);color:#a78bfa;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <h4>Competitive salary</h4>
            <p>Market-related packages reviewed annually with performance bonuses.</p>
        </div>
    </div>

    {# ── FOOTER ── #}
    <div class="footer">
        <div class="footer-left">
            <div class="footer-logo">Quick<span>Loan</span></div>
            <div class="footer-sep"></div>
            <span class="footer-copy">© 2025 QuickLoan (Pty) Ltd. All rights reserved.</span>
        </div>
        <div class="footer-links">
            <a href="#">Privacy Policy</a>
            <a href="#">Terms of Use</a>
            <a href="#">Contact</a>
        </div>
        <div>
            <span class="system-status"><span class="dot"></span>All systems operational</span>
        </div>
    </div>

</div>

{% endblock %}
