            </div>
        </div>
    </div>

    {# ── FILTER BAR ── #}
    <div class="filter-bar">
        <div class="search-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            <input type="text" placeholder="Search roles, departments…" />
        </div>
        <select class="filter-select">
            <option value="">All departments</option>
            <option>Engineering</option>
            <option>Finance</option>
            <option>Operations</option>
            <option>Sales</option>
            <option>Customer Support</option>
            <option>Legal & Compliance</option>
        </select>
        <select class="filter-select">
            <option value="">All locations</option>
            <option>Johannesburg</option>
            <option>Cape Town</option>
            <option>Durban</option>
            <option>Remote</option>
        </select>
        <div class="filter-divider"></div>
        <div class="pill-group">
            <button class="pill active">All</button>
            <button class="pill">Full-time</button>
            <button class="pill">Contract</button>
            <button class="pill">Remote</button>
        </div>
    </div>

    {# ── JOB LISTINGS ── #}
    <div class="jobs-section">
        <div class="section-meta">
            <h2>Open positions</h2>
            {# REPLACE: {{ jobs|length }} open roles #}
            <span>0 open roles</span>
        </div>

